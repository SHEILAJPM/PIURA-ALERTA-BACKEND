PORT=4000

# Ingesta del ESP32 por puerto serie. Si se deja vacío, esa ingesta queda
# desactivada (útil mientras se prueba solo con `npm run simulate`).
SERIAL_PORT=COM3
BAUD_RATE=115200

DATABASE_URL=postgresql://usuario:password@host/basededatos?sslmode=require

# Orígenes permitidos por CORS, separados por comas
# (ej. "https://piura-alerta.vercel.app,http://localhost:5173"). Si se deja
# vacío se acepta cualquier origen — cómodo en desarrollo, pero configúralo
# antes de exponer el backend en producción.
CORS_ORIGIN=

TELEGRAM_BOT_TOKEN=tu_token_de_botfather

# Clasificación best-effort de reportes ciudadanos (spam/sonseras) vía Groq
# (gratis en console.groq.com). Si se deja vacío, la función queda desactivada
# sin afectar nada más: los reportes se siguen guardando normal, solo sin la
# etiqueta de "posible spam" en el panel de admin. Ver src/services/moderacionIA.js.
GROQ_API_KEY=

# API key compartida para proteger POST /api/lecturas (ingesta de sensores).
# Si se deja vacío, el endpoint queda sin autenticar (solo para desarrollo
# local). El ESP32/simulador debe enviarla en el header `x-api-key`.
SENSOR_API_KEY=

# Secreto para firmar los tokens de sesión (JWT) de /api/auth. Sin esto,
# /api/auth/* y cualquier ruta que requiera sesión responden 500. Generar uno
# propio con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Reporte de errores en producción (cuenta gratis en sentry.io). Si se deja
# vacío, el backend sigue funcionando igual, solo sin reportar errores 500 a
# Sentry — quedan igual en los logs (ver src/lib/logger.js). Ver DEPLOY.md.
SENTRY_DSN=

# Notificaciones push del navegador ante cambios de estado del río (ver
# src/services/webpush.js). No es una cuenta externa: es un par de claves
# propio, generado una sola vez con:
#   node -e "console.log(require('web-push').generateVAPIDKeys())"
# Si se dejan vacíos, las notificaciones push quedan desactivadas sin afectar
# nada más. El frontend pide VAPID_PUBLIC_KEY en tiempo real vía
# GET /api/push/clave-publica, no hace falta copiarla a mano.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:contacto@piuraalerta.pe

# Alertas por SMS ante cambios de estado del río, a los usuarios que activaron
# el opt-in en su perfil (ver src/services/sms.js). Cuenta gratis con crédito
# de prueba en twilio.com/try-twilio — Account SID y Auth Token están en el
# Console Dashboard; TWILIO_FROM_NUMBER es el número de Twilio con capacidad
# SMS (Phone Numbers > Manage > Active Numbers). Mientras la cuenta esté en
# modo trial, solo se puede mandar SMS a números verificados manualmente en
# Phone Numbers > Verified Caller IDs. Si se dejan vacíos, los SMS quedan
# desactivados sin afectar nada más.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Correo de "olvidé mi contraseña" (ver src/services/email.js). Cuenta gratis
# en resend.com (sin tarjeta) — la API key sale del dashboard apenas creada.
# Mientras no verifiques un dominio propio, solo se puede mandar correo desde
# "onboarding@resend.dev" y solo LLEGA al correo con el que te registraste en
# Resend (limitación de su modo de prueba, igual que el trial de Twilio). Si
# se deja vacío, el enlace de recuperación queda solo en los logs del
# servidor (nunca en producción) para poder probar el flujo sin la cuenta.
RESEND_API_KEY=
RESEND_FROM=Piura Alerta <onboarding@resend.dev>

# Base del frontend para armar el enlace de recuperación de contraseña
# (ej. https://piura-alerta.vercel.app). En desarrollo local usa el default.
FRONTEND_URL=http://localhost:5173

# "development" localmente; en producción ponerlo en "production" (Render lo
# hace solo si se usa render.yaml). Afecta: formato de logs (JSON puro en vez
# de pino-pretty) y el tag `environment` que se manda a Sentry.
NODE_ENV=development
